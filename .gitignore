# Conversation/session logs everywhere
**/*.jsonl


# Auto-managed by Claude Code — not user config
plugins/marketplaces/

# Ephemeral session task data
tasks/

# Session UUID directories under projects (memory/ subdirs don't match *-*-*-*-*)
projects/*/*-*-*-*-*/

# Ephemeral tool/agent output within projects
projects/**/tool-results/
projects/**/subagents/
