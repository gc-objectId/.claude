# Mac metadata
.DS_Store

# Sensitive/ephemeral runtime files
history.jsonl
.last-cleanup
mcp-needs-auth-cache.json
policy-limits.json

# Large ephemeral directories
sessions/
paste-cache/
cache/
session-env/
shell-snapshots/
telemetry/
backups/
